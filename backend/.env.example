# Copia este archivo a .env y completa tus valores (nunca subas .env a GitHub)
# API key de Google AI Studio / Gemini
GOOGLE_API_KEY=...
MODEL_NAME=gemini-3.6-flash
EMBEDDING_MODEL=models/gemini-embedding-001
# Orígenes permitidos (separados por coma). Agrega aquí la URL de Vercel.
ALLOWED_ORIGINS=http://localhost:3000
# Opcional: regex para aceptar previews de Vercel
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
# Opcional: rutas alternativas de datos
# KB_PATH=data/politicas_cobranza.csv
# CARTERA_PATH=data/cartera_demo.csv
